## General Settings
#TZ=Asia/Karachi
#UID=1000
#GID=1000
DOMAIN=your-site.com
#HTTP_PORT=80
#HTTPS_PORT=443

## Traefik
# Generate via `docker run --rm httpd:2 htpasswd -nbB admin 'your-password'`
TRAEFIK_DASHBOARD_USERS='admin:your-bcrypt-hash'

## Postgres
#POSTGRES_PORT=5432
POSTGRES_PASSWORD=my-secret-password
#POSTGRES_USER=postgres
#POSTGRES_DB=postgres

## Valkey
#VALKEY_PORT=6380
VALKEY_PASSWORD=myLargeAlphaNumericPassword
VALKEY_URL=redis://:${VALKEY_PASSWORD}@valkey:6380

## Paperless
PAPERLESS_SECRET_KEY=my-secret-key
#PAPERLESS_OCR_LANGUAGE=eng
#PAPERLESS_OCR_LANGUAGES=deu
PAPERLESS_APPS=allauth.socialaccount.providers.openid_connect
PAPERLESS_SOCIALACCOUNT_PROVIDERS={"openid_connect":{"OAUTH_PKCE_ENABLED":true,"APPS":[{"provider_id":"authentik","name":"authentik","client_id":"<Client ID from authentik>","secret":"<Client Secret from authentik>","settings":{"server_url":"http://authentik.company/application/o/<application_slug>/.well-known/openid-configuration","fetch_userinfo":true}}],"SCOPE":["openid","profile","email"]}}
PAPERLESS_LOGOUT_REDIRECT_URL=http://authentik.company/application/o/<application_slug>/end-session/
# When set to true this bypasses extra sign-up prompts and auto-creates the account
PAPERLESS_SOCIAL_AUTO_SIGNUP=false
# When set to true this allows general sign-ups through social/OIDC providers
PAPERLESS_SOCIALACCOUNT_ALLOW_SIGNUPS=false

## Authentik
AUTHENTIK_SECRET_KEY=my-secret-key
#AUTHENTIK_ERROR_REPORTING__ENABLED=true
#AUTHENTIK_LOG_LEVEL=debug
